{
  "buildCommand": "node .github/scripts/vercel-build.mjs",
  "outputDirectory": "out",
  "installCommand": "npm ci --ignore-scripts",
  "framework": null,
  "rewrites": [
    {
      "source": "/:page(privacy|terms|guidelines|support|delete-account|legal-notice|girl)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/fr/:page(privacy|terms|guidelines|support|delete-account|legal-notice|girl)",
      "destination": "/fr/:page/index.html"
    },
    {
      "source": "/app/((?!_expo|assets|favicon|manifest|icon|apple-touch).*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/demo/((?!_expo|assets|favicon|manifest|icon|apple-touch).*)",
      "destination": "/demo/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ar"
        }
      ],
      "destination": "/ar/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://tiles.openfreemap.org https://alafrench7593-a11y.github.io https://images.unsplash.com; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(app|demo)/((?!_expo|assets).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
