{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://yqutcmgslwxcmnsqmhvy.supabase.co"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascAppId": "$ASC_APP_ID"
      }
    }
  }
}
